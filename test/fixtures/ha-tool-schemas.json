          },
          "media_type": {
            "type": "string",
            "enum": [
              "movie",
              "series"
            ],
            "description": "movie or series; POV is the default Kodi add-on for both."
          },
          "year": {
            "type": "number",
            "minimum": 1880,
            "maximum": 2200,
            "description": "Optional release year for ambiguous titles."
          },
          "season": {
            "type": "number",
            "minimum": 1,
            "maximum": 999,
            "description": "Explicit season number for a series; required for series playback."
          },
          "episode": {
            "type": "number",
            "minimum": 1,
            "maximum": 999,
            "description": "Explicit episode number for a series; required for series playback."
          }
        },
        "required": [
          "query",
          "media_type"
        ],
        "additionalProperties": false
      }
    }
